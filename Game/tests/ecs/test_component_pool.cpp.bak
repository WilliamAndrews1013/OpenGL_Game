#include <gtest/gtest.h>
#include "ecs/ComponentPool.hh"

using namespace ECS;

struct TestComponent {
  int value;
  float data;
};

TEST(ComponentPoolTest, AddAndRetrieve) {
  ComponentPool<TestComponent> pool;
  EntityID entity = 0;
  
  auto& comp = pool.Add(entity, {42, 3.14f});
  EXPECT_EQ(comp.value, 42);

  auto* retrieved = pool.Get(entity);
  ASSERT_NE(retrieved, nullptr);
  EXPECT_EQ(retrieved->value, 42);
}

TEST(ComponentPoolTest, RemoveComponent) {
  ComponentPool<TestComponent> pool;
  EntityID entity = 0;

  pool.Add(entity, {1, 1.0f});
  EXPECT_TRUE(pool.Has(entity));

  pool.Remove(entity);
  EXPECT_FALSE(pool.Has(entity));
  EXPECT_EQ(pool.Get(entity), nullptr);
}

TEST(ComponentPoolTest, DenseArrayIteration) {
  ComponentPool<TestComponent> pool;

  pool.Add(0, {1, 1.0f});
  pool.Add(5, {2, 2.0f});
  pool.Add(10, {3, 3.0f});

  int sum = 0;
  for (auto& comp : pool) {
    sum += comp.value;
  }
  EXPECT_EQ(sum, 6); // 1 + 2 + 3
}
