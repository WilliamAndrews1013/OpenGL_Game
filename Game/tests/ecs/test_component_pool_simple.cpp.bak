#include <gtest/gtest.h>
#include "ecs/ComponentPool.hh"

using namespace ECS;

struct TestComponent {
    int value;
    float data;
};

TEST(ComponentPoolTest, AddAndRetrieve) {
    ComponentPool<TestComponent> pool;
    EntityID entity = 0;
    
    // Test Add()
    auto& comp = pool.Add(entity, TestComponent{42, 3.14f});
    EXPECT_EQ(comp.value, 42);
    EXPECT_FLOAT_EQ(comp.data, 3.14f);
    
    // Test Has()
    EXPECT_TRUE(pool.Has(entity));
    
    // Test Size()
    EXPECT_EQ(pool.Size(), 1);
}

TEST(ComponentPoolTest, AddMultipleEntities) {
    ComponentPool<TestComponent> pool;
    
    // Add components for different entities
    pool.Add(0, TestComponent{1, 1.0f});
    pool.Add(5, TestComponent{2, 2.0f});
    pool.Add(10, TestComponent{3, 3.0f});
    
    // Check all exist
    EXPECT_TRUE(pool.Has(0));
    EXPECT_TRUE(pool.Has(5));
    EXPECT_TRUE(pool.Has(10));
    EXPECT_FALSE(pool.Has(1)); // Entity 1 doesn't have component
    
    // Check size
    EXPECT_EQ(pool.Size(), 3);
    
    // Check we can iterate
    int sum = 0;
    for (auto& comp : pool) {
        sum += comp.value;
    }
    EXPECT_EQ(sum, 6); // 1+2+3
}

int main(int argc, char **argv) {
    ::testing::InitGoogleTest(&argc, argv);
    return RUN_ALL_TESTS();
}
